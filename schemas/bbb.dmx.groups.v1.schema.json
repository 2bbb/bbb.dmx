{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2bbb/bbb.dmx/schemas/bbb.dmx.groups.v1.schema.json",
  "title": "bbb.dmx fixture groups v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": "bbb.dmx.groups.v1"
    },
    "groups": {
      "description": "Map of group id to explicit patch fixture ids. Wildcards are intentionally unsupported in v1.",
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer"
            }
          ]
        }
      }
    }
  }
}
